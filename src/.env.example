# Azure AI Foundry project + Guardian Agent
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
GUARDIAN_AGENT_ID=
GUARDIAN_AGENT_NAME=guardian-vision-agent

# Credential mode: default (DefaultAzureCredential) or key (Foundry account key)
AZURE_CREDENTIAL_MODE=default

# Foundry model inference (account key used when credential mode is key)
AZURE_OPENAI_API_KEY=
VISION_DEPLOYMENT=gpt-4o
TEXT_DEPLOYMENT=gpt-5-mini

# Azure AI Speech
SPEECH_KEY=
SPEECH_REGION=
TTS_VOICE=en-US-JennyNeural

# Trust engine thresholds (0-1)
TRUST_HIGH_THRESHOLD=0.75
TRUST_LOW_THRESHOLD=0.45
