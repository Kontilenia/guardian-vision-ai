# Azure AI Foundry project + Guardian Agent
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
GUARDIAN_AGENT_ID=
GUARDIAN_AGENT_NAME=guardian-vision-agent

# Credential mode: default (DefaultAzureCredential) or key
AZURE_CREDENTIAL_MODE=default

# Azure OpenAI (GPT-4o vision + GPT-5.x Mini text)
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
VISION_DEPLOYMENT=gpt-4o
TEXT_DEPLOYMENT=gpt-5-mini

# Azure AI Speech
SPEECH_KEY=
SPEECH_REGION=
TTS_VOICE=en-US-JennyNeural

# Azure AI Content Safety
CONTENT_SAFETY_ENDPOINT=https://<your-content-safety>.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=

# Trust engine thresholds (0-1)
TRUST_HIGH_THRESHOLD=0.75
TRUST_LOW_THRESHOLD=0.45
